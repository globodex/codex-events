{
  "scanners": [
    {
      "id": "typescript",
      "source": "@groma/scanner-typescript@0.2.4",
      "include": [
        "/package.json",
        "/tsconfig.json",
        "/app/domains/events/presentation.ts",
        "/app/domains/events/public-homepage.ts",
        "/app/domains/events/states.ts",
        "/server/api/public/events/index.get.ts",
        "/server/api/public/events/\\[slug\\]/index.get.ts",
        "/server/domains/events/public-cache.ts",
        "/shared/domains/events/certificates.ts",
        "/shared/domains/events/prizes.ts",
        "/shared/http/public-cache-topology.ts"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    }
  ],
  "workSources": [],
  "automaticUpdates": false
}
