{
  "name": "codex-events",
  "private": true,
  "version": "1.33.2",
  "packageManager": "bun@1.4.5",
  "type": "module",
  "scripts": {
    "auth0:custom-domain": "bun tools/auth0/auth0-custom-domain.ts",
    "build": "nuxt build",
    "build:cloudflare": "NITRO_PRESET=cloudflare_module nuxt build",
    "build:storybook": "storybook build --disable-telemetry",
    "db:local:guard": "bun tools/d1/ensure-local-state-path.ts",
    "deploy:config:test": "bun tools/deploy/generate-wrangler-config.ts test",
    "deploy:config:production": "bun tools/deploy/generate-wrangler-config.ts production",
    "deploy:ensure-d1:test": "bun tools/deploy/ensure-d1-database.ts test",
    "deploy:ensure-d1:production": "bun tools/deploy/ensure-d1-database.ts production",
    "deploy:ensure-r2:test": "bun tools/deploy/ensure-r2-buckets.ts test",
    "deploy:ensure-r2:production": "bun tools/deploy/ensure-r2-buckets.ts production",
    "deploy:ensure-queues:test": "bun tools/deploy/ensure-queues.ts test",
    "deploy:ensure-queues:production": "bun tools/deploy/ensure-queues.ts production",
    "deploy:queue-consumers:test": "bun tools/deploy/reconcile-queue-consumers.ts test",
    "deploy:queue-consumers:production": "bun tools/deploy/reconcile-queue-consumers.ts production",
    "db:migrate:test": "bun run deploy:ensure-d1:test && bun run deploy:config:test && bun tools/deploy/run-wrangler.ts d1 migrations apply DB --remote --config .wrangler/generated/test.jsonc",
    "db:migrate:production": "bun run deploy:ensure-d1:production && bun run deploy:config:production && bun tools/deploy/run-wrangler.ts d1 migrations apply DB --remote --config .wrangler/generated/production.jsonc",
    "dev": "LOCAL_D1_STATE_ROOT=${LOCAL_D1_STATE_ROOT:-${LOCAL_DEV_D1_STATE_ROOT:-.wrangler/state}} bun run dev:inner",
    "dev:inner": "bun run db:local:guard && CI=1 wrangler d1 migrations apply DB --local --persist-to ${LOCAL_D1_STATE_ROOT} --config wrangler.jsonc && nuxt dev",
    "deploy:worker:test": "bun run deploy:ensure-d1:test && bun run deploy:ensure-r2:test && bun run deploy:config:test && bun tools/deploy/run-wrangler.ts deploy --config .wrangler/generated/test.jsonc",
    "deploy:worker:production": "bun run deploy:ensure-d1:production && bun run deploy:ensure-r2:production && bun run deploy:config:production && bun tools/deploy/run-wrangler.ts deploy --config .wrangler/generated/production.jsonc",
    "deploy:test": "bun run deploy:worker:test && bun run deploy:queue-consumers:test",
    "deploy:production": "bun run deploy:worker:production && bun run deploy:queue-consumers:production",
    "db:generate": "drizzle-kit generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "mcp:generate-operation-catalog": "bun tools/mcp/generate-operation-catalog.ts",
    "mcp:generate-output-schemas": "bun tools/mcp/generate-output-schemas.ts",
    "notices:generate": "bun tools/licenses/generate-third-party-notices.ts",
    "typecheck": "nuxt typecheck",
    "release:version": "bun tools/releases/release-version.ts",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open --no-version-updates --disable-telemetry",
    "test:bdd:install": "playwright install chromium",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:bdd": "bun --no-env-file tests/bdd/run.ts",
    "test:bdd:account-workspace": "bun --no-env-file tests/bdd/run.ts topology",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:bdd"
  },
  "dependencies": {
    "@auth0/auth0-nuxt": "1.3.0",
    "@iconify-json/lucide": "1.2.157",
    "@modelcontextprotocol/server": "2.4.0",
    "@nuxt/icon": "2.6.3",
    "@pdf-lib/fontkit": "1.1.1",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "15.0.0",
    "agents": "0.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "0.45.4",
    "fuse.js": "^7.5.0",
    "highlight.js": "11.12.0",
    "jose": "6.2.18",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.3",
    "md-editor-v3": "^7.1.1",
    "nuxt": "4.6.4",
    "pdf-lib": "1.17.1",
    "photoswipe": "^5.4.4",
    "prettier": "3.10.1",
    "qrcode-generator": "2.0.4",
    "reka-ui": "^2.11.0",
    "satori": "0.63.2",
    "screenfull": "6.0.2",
    "shadcn-nuxt": "2.9.0",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "4.3.5",
    "vee-validate": "^4.15.1",
    "vue-sonner": "2.0.9",
    "zod": "4.6.7"
  },
  "overrides": {
    "h3@^1": "1.15.11",
    "@babel/core@^7": "7.29.13",
    "baseline-browser-mapping": "2.11.39",
    "brace-expansion": "5.0.13",
    "browserslist": "4.29.6",
    "defu": "6.1.7",
    "esbuild": "0.28.2",
    "fflate": "0.7.5",
    "glob": "14.0.6",
    "js-yaml": "4.3.2",
    "minimatch": "11.0.9",
    "nanoid@^3": "3.3.20",
    "picomatch@^2": "2.3.2",
    "picomatch@^4": "4.0.7",
    "postcss": "8.5.33",
    "source-map-js": "1.2.4",
    "tar": "7.5.23",
    "@vue/compiler-core": "3.5.46",
    "@vue/compiler-dom": "3.5.46",
    "@vue/compiler-sfc": "3.5.46"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.65.1",
    "@storybook-vue/nuxt": "10.0.3",
    "@storybook/addon-docs": "10.6.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "26.6.6",
    "@types/sortablejs": "^1.15.9",
    "@types/sql.js": "^1.16.0",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "lighthouse": "^13.6.0",
    "playwright-bdd": "9.2.1",
    "sql.js": "^1.17.0",
    "storybook": "10.6.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14",
    "wrangler": "^4.166.0"
  },
  "patchedDependencies": {
    "@vue/language-core@3.3.14": "patches/@vue%2Flanguage-core@3.3.14.patch"
  }
}
